{
  "name": "drugtrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent drug/target/trial discovery graph: parallel Qwen subagents per data source, deterministic match/verify, local graph storage, Qwen review. Fully local, no API keys.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "run": "tsx src/testDrugTrack.ts",
    "studio": "langgraphjs dev",
    "viz": "tsx src/serveViz.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.37",
    "@langchain/langgraph": "^0.2.44",
    "@langchain/ollama": "0.2.4",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.4.5",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
