# Copy to .env and fill in. .env is gitignored.

# Ollama must be running locally with these models pulled:
#   ollama pull qwen2.5:3b   (small/fast - data parsing)
#   ollama pull qwen2.5:7b   (larger - reasoning: backtest, review, critique)
OLLAMA_BASE_URL=http://localhost:11434
SMALL_MODEL=qwen2.5:3b
LARGE_MODEL=qwen2.5:7b

# How many times autoDebugNode will retry a failed subagent before escalating.
MAX_AUTO_DEBUG_RETRIES=2

# "Move on fast" policy: any single Qwen call slower than this is abandoned
# rather than waited out, so one slow source can never stall the whole run.
PARSE_TIMEOUT_MS=12000
QWEN_CALL_TIMEOUT_MS=20000
FETCH_TIMEOUT_MS=10000

# Optional LangSmith tracing (same pattern as the peptide project).
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=drugtrack
